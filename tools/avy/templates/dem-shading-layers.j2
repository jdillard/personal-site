{
    "cfglayers": [
        {% if grm_layer %}
        {
            "type": "Feature",
            "id": "6a1f3c2e-5b7d-4e8a-9c0f-2d4b6e8a1c3f",
            "geometry": null,
            "properties": {
                "title": "{{ sun_day }} Steep Terrain To Avoid (GRM)",
                "alias": "{{ grm_layer }}",
                "class": "ConfiguredLayer"
            }
        }{% if danger_layer %},{% endif %}{% endif %}
        {% if danger_layer %}
        {
            "type": "Feature",
            "id": "fbfd2235-dc90-4f6f-bead-4826d4983f82",
            "geometry": null,
            "properties": {
                "title": "{{ sun_day }} Avalanche Danger",
                "alias": "{{ danger_layer }}",
                "class": "ConfiguredLayer"
            }
        }{% if problem_layers %},{% endif %}{% endif %}{% for problem in problem_layers %}
        {
            "type": "Feature",
            "id": "{{ problem.uuid }}",
            "geometry": null,
            "properties": {
                "title": "{{ problem.name }}",
                "alias": "{{ problem.layers }}",
                "class": "ConfiguredLayer"
            }
        }{% if not loop.last %},{% endif %}{% endfor %}
    ]
}
