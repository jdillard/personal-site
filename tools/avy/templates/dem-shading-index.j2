---
layout: page
title: Avalanche Forecast Layers for CalTopo
description: The latest avalanche forecasts as CalTopo map layers, with danger rating and avalanche problem shading for each advisory zone.
tool: avy
image:
  path: /assets/images/avy-layers.png
  width: 175
  height: 131
js_includes:
  - https://unpkg.com/leaflet@1.9.4/dist/leaflet.js
  - avy.js
css_includes:
 - https://unpkg.com/leaflet@1.9.4/dist/leaflet.css
---

<!-- Looking out for you... -->

<section class="measure center lh-copy f5-ns f6 ph2 mv3" style="text-align: justify;">
    The latest avalanche forecasts as CalTopo map layers. Each advisory zone gets danger rating and avalanche problem shading, pulled automatically from the local forecast center. Open a zone in CalTopo with one click, or copy the DEM shading rules into your own map. This is a planning aid, not a replacement for reading the full forecast.
</section>

<div>
    <div class="mt4 ph2 tc">
        <span class="avy-picker">
            <label for="indexSel">Region</label>
            <select class="avy-select" id="indexSel">
                <option value="all" selected="">All Regions</option>
                <optgroup label="US">
                    {% for state in states %}
                    {% if state.active %}
                    <option value="{{ state.state | lower }}">{{ state.name }}</option>
                    {% endif %}
                    {% endfor %}
                </optgroup>
                <optgroup label="Canada">
                    <option value="canada">Canada</option>
                </optgroup>
            </select>
        </span>
    </div>
</div>

<div id="avy-layout" class="avy-layout ph3 mt3">
    <div class="avy-layout-map">
        <div class="avy-map-card avy-map-framed">
            <h3 id="map-title" class="avy-layer-title">All Forecast Zones</h3>
            <span class="avy-map-tip">Click a zone to open</span>
            <div class="avy-map" id="map"></div>
        </div>
    </div>
    <div class="avy-regions">
    {% for state in states %}
    {% if state.active %}
        <div id="{{ state.state | lower }}-region" class="avy-region avy-layer">
            <h3 class="avy-layer-title"><a class="no-underline fancy-link relative dark-gray hover-light-red" href="{{ state.page }}.html">{{ state.name }}</a></h3>
            <ul id="{{ state.state | lower }}-zones" class="list pl1 f5 mv1">
                {% for zone in state.zones %}
                <li data-zone="{{ zone.slug }}" data-color="{{ zone.color }}" class="pv1">
                    <div style="clear: both;background-color: {{ zone.color }}" class="fl mr2 h1 w1"></div>
                    <a class="no-underline fancy-link relative black-70 hover-light-red" href="{{ state.page }}.html#zone-{{ zone.slug }}" title="{{ zone.name }}">{{ zone.short_name | default(zone.name) }}</a>
                </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    {% endfor %}
        <div id="canada-region" class="avy-region avy-layer">
            <h3 class="avy-layer-title"><a class="no-underline fancy-link relative dark-gray hover-light-red" href="/avy/canada.html">Canada</a></h3>
            <ul id="canada-zones" class="list pl1 f5 mv1">
                {% for area in areas %}
                <li data-zone="{{ area.slug }}" data-color="{{ area.color }}"{% if area.has_subregions %} data-subregions="true"{% endif %} class="pv1">
                    <div style="clear: both;background-color: {{ area.color }}" class="fl mr2 h1 w1"></div>
                    <a class="no-underline fancy-link relative black-70 hover-light-red" href="/avy/canada.html#zone-{{ area.slug }}" title="{{ area.name }}">{{ area.short_name }}</a>
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>

{% raw %}
{% include feedback.html %}
{% endraw %}
